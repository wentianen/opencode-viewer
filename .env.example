# Host and port for the local viewer service.
ACTIVITY_VIEWER_HOST=127.0.0.1
ACTIVITY_VIEWER_PORT=4310

# Log directory watched by the service and written by the plugin.
ACTIVITY_VIEWER_LOG_DIR=./.activity-logs

# Set to false to keep the service from opening a browser tab on startup.
ACTIVITY_VIEWER_OPEN_BROWSER=true
